# Build stage
# python:3.14-slim (multi-arch: linux/amd64, linux/arm64)
FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6 AS builder

# uv 0.11.25 (multi-arch: linux/amd64, linux/arm64)
COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:1e3808aa9023d0980e7c15b1fa7c1ac16ff35925780cf5c459858b2d693f01a9 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git xmlsec1 libxmlsec1-dev pkg-config && rm -rf /var/lib/apt/lists/*

COPY observal-server/pyproject.toml observal-server/uv.lock ./
COPY packages/observal-shared/ ../packages/observal-shared/
ENV UV_HTTP_TIMEOUT=300 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project


# Runtime stage
# python:3.14-slim (multi-arch: linux/amd64, linux/arm64)
FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6

RUN groupadd --system --gid 1001 appgroup && \
    useradd --system --uid 1001 --gid appgroup appuser && \
    mkdir -p /data && chown appuser:appgroup /data

RUN apt-get update && apt-get install -y --no-install-recommends git xmlsec1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --chown=appuser:appgroup observal-server/ .
COPY --chown=appuser:appgroup docker/entrypoint.sh /app/entrypoint.sh
# Root fs is read-only at runtime, so precompile app bytecode here (otherwise every start recompiles).
RUN sed -i 's/\r$//' /app/entrypoint.sh && \
    /app/.venv/bin/python -m compileall -q -j0 -x '/\.venv/' /app

USER 1001:1001

EXPOSE 8000

CMD ["/app/entrypoint.sh"]
